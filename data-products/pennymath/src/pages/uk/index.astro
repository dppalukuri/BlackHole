---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculatorDirectory from '../../components/CalculatorDirectory.astro';
import { CALCULATORS } from '../../data/calculators';

const calculators = CALCULATORS.filter((c) => c.country === 'UK');
---

<BaseLayout
  title="UK Financial Calculators: Mortgage, Pension, ISA and More | PennyMath"
  description={`${calculators.length} free financial calculators for the UK. Mortgage payments, ISA growth, pension projections and savings. No signup.`}
>
  <nav class="breadcrumbs">
    <a href="/">Home</a> <span>/</span> UK
  </nav>

  <h1>UK calculators</h1>
  <p class="page-intro">Plan your mortgage, project your pension and compare savings using pound figures.</p>

  <CalculatorDirectory calculators={calculators} detailed />
</BaseLayout>
