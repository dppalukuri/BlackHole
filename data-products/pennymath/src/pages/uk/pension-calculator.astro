---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SIPCalculator from '../../components/calculators/engines/SIPCalculator';
import FAQ from '../../components/FAQ.astro';

const faqs = [
  {
    q: `How much should I contribute?`,
    a: `Target 15% of gross income across employer + employee. The auto-enrolment 8% minimum is below what most people need for a comfortable retirement. PLSA estimates ~£43,100/year for a single-person 'comfortable' retirement, implying a pot of ~£600-800k.`,
  },
  {
    q: `2026 annual allowance?`,
    a: `£60,000 standard. Tapered to as low as £10,000 for earners over £260,000. Carry forward unused allowance from previous 3 tax years if needed.`,
  },
  {
    q: `Workplace pension vs SIPP?`,
    a: `Workplace first for the employer match. SIPP next for more control + lower fees. Many people end up with both, plus consolidated old workplace pensions in their SIPP.`,
  },
  {
    q: `When can I access it?`,
    a: `Age 55 (57 from April 2028). 25% tax-free lump sum (capped at £268,275), remainder taxed as income. Early access triggers a ~55% penalty unless on rare medical grounds.`,
  },
  {
    q: `What return rate should I plan for?`,
    a: `6% real (after inflation) is a reasonable baseline for an equity-heavy portfolio. Don't plan around 10%+ — that's optimistic over multi-decade horizons net of fees and inflation.`,
  },
];
---
<BaseLayout
  title="UK Pension Calculator - Workplace & SIPP Growth | PennyMath"
  description="Free UK pension calculator. Project your pension pot at retirement with monthly contributions, employer matching, and compound growth. SIPP and workplace pensions."
  keywords="uk pension calculator, pension calculator uk, workplace pension calculator, sipp calculator, retirement calculator uk"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "UK Pension Calculator",
      "url": "https://pennymath.techtools365.com/uk/pension-calculator",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "GBP" }
    })} />
  </Fragment>

  <nav class="breadcrumbs">
    <a href="/">Home</a> <span>/</span>
    <a href="/uk/">UK</a> <span>/</span>
    Pension Calculator
  </nav>

  <h1>UK Pension Calculator</h1>
  <p class="page-subtitle">Project your pension pot at retirement</p>
  <p class="page-intro">
    See how monthly pension contributions grow with compound returns over your working life. Useful for workplace pensions, SIPPs, or combined retirement saving.
  </p>

  <SIPCalculator
    client:visible
    currency={{ code: 'GBP', symbol: '£' }}
    defaults={{ monthlyInvestment: 500, expectedReturn: 6, timePeriod: 30 }}
  />

  <section class="content-section">
    <h2>The Power of Tax Relief + Time</h2>
    <p>
      UK pension contributions get tax relief at your marginal rate. For a basic-rate taxpayer, every £80 you put in becomes £100. For a higher-rate taxpayer, every £60 becomes £100. That's a 25% or 67% instant return before any investment growth.
    </p>
    <p>
      Combined with employer contributions and compound growth over 30+ years, the result is dramatic. Saving £500/month at a 6% real return:
    </p>
    <ul>
      <li><strong>For 40 years (age 25-65):</strong> £952,000</li>
      <li><strong>For 30 years (age 35-65):</strong> £495,000</li>
      <li><strong>For 20 years (age 45-65):</strong> £225,000</li>
      <li><strong>For 10 years (age 55-65):</strong> £80,000</li>
    </ul>
    <p>
      Starting at 25 instead of 35 nearly doubles your pot — for the same monthly contribution. The first decade of pension saving is the most powerful decade you'll ever have.
    </p>
  </section>

  <section class="content-section">
    <h2>Don't Miss the Employer Match</h2>
    <p>
      Auto-enrolment mandates a minimum of 8% total contribution (3% employer, 5% employee). Many employers will match additional contributions — common offers include:
    </p>
    <ul>
      <li>Match up to 5% (so 5% from you + 5% from them = 10% total)</li>
      <li>Match £1 for £1 up to a cap (e.g., 6% employer if you contribute 6%)</li>
      <li>Salary sacrifice arrangements that save NI on both sides</li>
    </ul>
    <p>
      If your employer matches and you're not capturing the full match, you're leaving free money on the table. Even small differences compound enormously — an extra 2% employer match on a £40,000 salary, invested for 30 years at 6%, becomes ~£67,000.
    </p>
  </section>

  <section class="content-section">
    <h2>2026 UK Pension Rules</h2>
    <ul>
      <li><strong>Annual allowance:</strong> £60,000/year (tapered for high earners)</li>
      <li><strong>Tax-free lump sum cap:</strong> £268,275 (was unlimited pre-2024)</li>
      <li><strong>Minimum access age:</strong> 55 (rising to 57 in April 2028)</li>
      <li><strong>State Pension age:</strong> 66 (rising to 67 between 2026-2028)</li>
      <li><strong>Carry-forward:</strong> Unused allowance from previous 3 years</li>
    </ul>
  </section>

  <FAQ faqs={faqs} />

  <section>
    <h2>Related Calculators</h2>
    <div class="related-grid">
      <a href="/uk/isa-calculator" class="related-card">
        <h3>ISA Calculator</h3>
        <p>Tax-free growth — pairs well with pensions.</p>
      </a>
      <a href="/uk/savings-calculator" class="related-card">
        <h3>Savings Calculator</h3>
        <p>Short-term goals and emergency funds.</p>
      </a>
      <a href="/uk/mortgage-calculator" class="related-card">
        <h3>Mortgage Calculator</h3>
        <p>Estimate monthly home loan payments.</p>
      </a>
    </div>
  </section>
</BaseLayout>
