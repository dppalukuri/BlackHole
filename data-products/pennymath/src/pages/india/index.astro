---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculatorDirectory from '../../components/CalculatorDirectory.astro';
import { CALCULATORS } from '../../data/calculators';

const calculators = CALCULATORS.filter((c) => c.country === 'India');
---

<BaseLayout
  title="India Financial Calculators: Home Loans, SIP, Tax and More | PennyMath"
  description={`${calculators.length} free financial calculators for India. Home loans, SIP, EPF, NPS, income tax, HRA, GST and more. No signup.`}
>
  <nav class="breadcrumbs">
    <a href="/">Home</a> <span>/</span> India
  </nav>

  <h1>India calculators</h1>
  <p class="page-intro">Plan home loans, investments, tax and take-home pay using Indian rules and rupee figures.</p>

  <CalculatorDirectory calculators={calculators} detailed />
</BaseLayout>
