---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteSearch from '../components/SiteSearch.astro';
import DuskHero from '../components/DuskHero.astro';
import CalculatorDirectory from '../components/CalculatorDirectory.astro';
import QuickLoanEstimate from '../components/calculators/engines/QuickLoanEstimate';
import { CALCULATORS } from '../data/calculators';

const site = 'https://pennymath.techtools365.com';
const count = CALCULATORS.length;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site}/#website`,
      "url": `${site}/`,
      "name": "PennyMath",
      "description": "Free online financial calculators for India, the UAE, the UK and the US.",
      "inLanguage": "en",
      "publisher": { "@id": "https://techtools365.com/#org" }
    },
    {
      "@type": "ItemList",
      "name": "PennyMath free financial calculators",
      "numberOfItems": count,
      "itemListElement": CALCULATORS.map((c, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": `${c.name} (${c.country})`,
        "url": `${site}${c.path}`
      }))
    }
  ]
};
---

<BaseLayout
  title="Free Financial Calculators for India, UAE, UK and US | PennyMath"
  description={`${count} free financial calculators for India, the UAE, the UK and the US. Home loans, SIP, tax, salary, gratuity, Dubai property and more. No signup.`}
  keywords="free financial calculator, EMI calculator, SIP calculator, mortgage calculator UAE, UK mortgage calculator, gratuity calculator, tax calculator India, rent vs buy calculator"
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <!-- impact.com partner property verification -->
    <Fragment set:html={`<meta name='impact-site-verification' value='45691ff7-ed8e-4cbf-8a82-e43edf9f7449'>`} />
  </Fragment>

  <section class="hero">
    <DuskHero />
    <div class="hero-copy">
      <h1>Know the numbers before you decide</h1>
      <p>{count} free money calculators for India, the UAE, the UK and the US. No signup.</p>
      <SiteSearch variant="hero" />
    </div>
  </section>

  <section class="directory">
    <h2 class="directory-title">Every calculator, by what you need to decide</h2>
    <CalculatorDirectory calculators={CALCULATORS} />
  </section>

  <section class="try">
    <QuickLoanEstimate client:visible />
  </section>
</BaseLayout>
