---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculatorDirectory from '../../components/CalculatorDirectory.astro';
import { CALCULATORS } from '../../data/calculators';

const calculators = CALCULATORS.filter((c) => c.country === 'US');
---

<BaseLayout
  title="US Financial Calculators: Mortgage, 401(k), IRA, Loans and More | PennyMath"
  description={`${calculators.length} free financial calculators for the US. Mortgage, 401(k), Roth IRA, investment, auto loan, savings and more. No signup.`}
>
  <nav class="breadcrumbs">
    <a href="/">Home</a> <span>/</span> US
  </nav>

  <h1>US calculators</h1>
  <p class="page-intro">Plan loans, retirement and savings using dollar figures.</p>

  <CalculatorDirectory calculators={calculators} detailed />
</BaseLayout>
