---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrepaymentCalculator from '../../components/calculators/engines/PrepaymentCalculator';
import CalculatorSchema from '../../components/CalculatorSchema.astro';
import FAQ from '../../components/FAQ.astro';
import { comparePrepayment } from '../../lib/formulas/prepayment';
import { formatCurrency } from '../../lib/formatters';

const title = 'Mortgage Early Repayment Calculator (UAE)';
const description = 'Free UAE mortgage early repayment calculator. See how much a partial settlement saves after the bank fee, and compare a shorter term with a lower monthly payment.';
const path = '/uae/mortgage-early-repayment-calculator';
const aed = (n: number) => formatCurrency(n, 'AED');
const ex = comparePrepayment({ balance: 1200000, annualRate: 5.5, remainingMonths: 240, lumpSum: 200000, extraMonthly: 0, fee: 2000 });

const faqs = [
  {
    q: `What is the fee for partial settlement of a UAE mortgage?`,
    a: `A 2019 Central Bank of the UAE circular capped early or partial settlement fees on home loans at 1% of the outstanding balance or AED 10,000, whichever is lower. Banks can charge less, and some allow a free amount each year, so check your contract.`,
  },
  {
    q: `Should I shorten my mortgage term or lower my payment?`,
    a: `Shortening the term usually saves more interest, because you keep repaying at the higher amount. Lowering the payment leaves more cash free each month. Check which options your bank offers, since some apply a part-payment one way by default.`,
  },
  {
    q: `Is it worth paying off a mortgage early in the UAE?`,
    a: `It depends on your rate and the alternatives. There is no income tax in the UAE to offset mortgage interest, so the saving is simple, but investments may earn more with more risk. Keep an emergency fund, particularly as an expat whose residency may depend on employment.`,
  },
  {
    q: `Does the fee apply if I pay off the whole mortgage?`,
    a: `Full settlement usually carries the same capped fee, and you may also pay to release the mortgage at the land department. Ask your bank for a settlement letter that sets out the amounts.`,
  },
];
---

<BaseLayout title="Mortgage Early Repayment Calculator UAE — Partial Settlement Savings | PennyMath" description={description}>
  <Fragment slot="head">
    <CalculatorSchema name={title} description={description} path={path} priceCurrency="AED" countryName="UAE" countryPath="/uae/" />
  </Fragment>

  <nav class="breadcrumbs"><a href="/">Home</a> <span>/</span> <a href="/uae/">UAE</a> <span>/</span> Mortgage Early Repayment Calculator</nav>

  <h1>{title}</h1>
  <p class="page-subtitle">See how much a partial settlement saves after fees</p>
  <p class="page-intro">
    Enter a lump sum, a monthly top-up or both, then compare finishing sooner with lowering your monthly payment.
  </p>

  <PrepaymentCalculator
    client:visible
    currency={{ code: 'AED', symbol: 'AED ' }}
    paymentWord="payment"
    termWord="term"
    feeCap={{ percent: 1, max: 10000 }}
    amountRange={{ min: 50000, max: 10000000, step: 10000 }}
    maxTenureYears={25}
    defaults={{ balance: 1200000, annualRate: 5.5, remainingYears: 20, lumpSum: 200000, fee: 2000 }}
  />

  <section class="content-section">
    <h2>Shorter Term or Lower Payment?</h2>
    <p>
      After a partial settlement, your bank can either keep your payment and shorten the mortgage, or keep the end date and lower your payment. Keeping the payment usually saves more interest. Lowering it gives you more cash each month.
    </p>
    <p>
      <strong>Example:</strong> {aed(1200000)} at 5.50% with 20 years left, a {aed(200000)} partial settlement and a {aed(2000)} fee. Keeping the payment at {aed(ex.shorterTerm.payment)} finishes the mortgage {240 - ex.shorterTerm.months} months early and saves {aed(ex.shorterTerm.netSaving)} after the fee. Lowering the payment to {aed(ex.lowerPayment.payment)} saves {aed(ex.lowerPayment.netSaving)}.
    </p>
  </section>

  <section class="content-section">
    <h2>How to Use This Calculator</h2>
    <ol class="how-to-steps">
      <li>Enter your <strong>outstanding balance</strong>, rate and remaining term from your latest statement</li>
      <li>Add a <strong>lump sum</strong>, a <strong>monthly extra payment</strong> or both</li>
      <li>Enter the <strong>fee</strong> your bank quotes. A prompt shows the 1% cap for your balance</li>
      <li>Compare the <strong>net saving</strong> and new payment under each option</li>
    </ol>
    <p>The calculation assumes your rate stays the same. Most UAE mortgages become variable after a fixed period, so treat the saving as an estimate.</p>
  </section>

  <FAQ faqs={faqs} />

  <section>
    <h2>Related Calculators</h2>
    <div class="related-grid">
      <a href="/uae/mortgage-buyout-calculator" class="related-card"><h3>Mortgage Buyout Calculator</h3><p>See if moving to another bank saves money after fees.</p></a>
      <a href="/uae/fixed-to-floating-mortgage-calculator" class="related-card"><h3>Fixed to Floating Calculator</h3><p>See your payment when a fixed rate reverts to EIBOR plus margin.</p></a>
      <a href="/uae/gratuity-calculator" class="related-card"><h3>UAE Gratuity Calculator</h3><p>Calculate the end-of-service benefit you could put towards your mortgage.</p></a>
    </div>
  </section>
</BaseLayout>
