---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculatorDirectory from '../../components/CalculatorDirectory.astro';
import { CALCULATORS } from '../../data/calculators';

const calculators = CALCULATORS.filter((c) => c.country === 'UAE');
---

<BaseLayout
  title="UAE Financial Calculators: Mortgages, Gratuity, Property and More | PennyMath"
  description={`${calculators.length} free financial calculators for the UAE. Mortgages, gratuity, VAT, Dubai property costs, rental yield and remittances. No signup.`}
>
  <nav class="breadcrumbs">
    <a href="/">Home</a> <span>/</span> UAE
  </nav>

  <h1>UAE calculators</h1>
  <p class="page-intro">Plan a mortgage, a property purchase or your end-of-service benefit using UAE rules and dirham figures.</p>

  <CalculatorDirectory calculators={calculators} detailed />
</BaseLayout>
