---
import { ADSENSE_CLIENT, AD_SLOTS, isAdSlotConfigured, anyAdSlotConfigured } from '../lib/ads';
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  keywords?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
  ogType?: 'website' | 'article';
}

import AdScripts from '../components/AdScripts.astro';
import SiteSearch from '../components/SiteSearch.astro';
import { COUNTRIES } from '../data/calculators';

const {
  title,
  description,
  canonicalUrl,
  ogImage,
  keywords,
  jsonLd,
  ogType = 'website',
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://pennymath.techtools365.com';
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
const og = ogImage || `${siteUrl}/og-default.png`;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#15161E" />

  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="author" content="TechTools365" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow" />
  <meta name="google-adsense-account" content="ca-pub-9446467058878539" />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="PennyMath — TechTools365" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:locale:alternate" content="en_IN" />
  <meta property="og:locale:alternate" content="en_AE" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={og} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://pagead2.googlesyndication.com" />
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300..700&display=swap" rel="stylesheet" />

  <AdScripts />

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <slot name="head" />
</head>
<body>
  <header class="top">
    <a class="mark" href="/" aria-label="PennyMath home">
      <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><defs><radialGradient id="penny" cx="34%" cy="30%" r="80%"><stop offset="0" stop-color="#F7BE92"></stop><stop offset="1" stop-color="#C4652A"></stop></radialGradient></defs><circle cx="15" cy="15" r="14" fill="url(#penny)"></circle><circle cx="15" cy="15" r="10.8" fill="none" stroke="#FFF" stroke-opacity=".45"></circle></svg>
      PENNYMATH
    </a>
    <nav class="countries" aria-label="Countries">
      {COUNTRIES.map((c) => (
        <a href={c.path} class={currentPath.startsWith(c.path) ? 'is-active' : ''} aria-current={currentPath.startsWith(c.path) ? 'true' : undefined}>{c.name}</a>
      ))}
    </nav>
    {currentPath !== '/' && <SiteSearch variant="header" />}
  </header>

  {isAdSlotConfigured(AD_SLOTS.leftRail) && (
    <aside class="rail rail-left" aria-label="Advertisement">
      <ins class="adsbygoogle" style="display:block" data-ad-client={ADSENSE_CLIENT} data-ad-slot={AD_SLOTS.leftRail} data-ad-format="vertical" data-full-width-responsive="false" />
    </aside>
  )}

  <main class="main">
    <slot />
    {isAdSlotConfigured(AD_SLOTS.inline) && (
      <aside class="ad-inline" aria-label="Advertisement">
        <ins class="adsbygoogle" style="display:block" data-ad-client={ADSENSE_CLIENT} data-ad-slot={AD_SLOTS.inline} data-ad-format="auto" data-full-width-responsive="true" />
      </aside>
    )}
  </main>

  {isAdSlotConfigured(AD_SLOTS.rightRail) && (
    <aside class="rail rail-right" aria-label="Advertisement">
      <ins class="adsbygoogle" style="display:block" data-ad-client={ADSENSE_CLIENT} data-ad-slot={AD_SLOTS.rightRail} data-ad-format="vertical" data-full-width-responsive="false" />
    </aside>
  )}

  <footer class="site-footer">
    <div class="footer-inner">
      <p>PennyMath by <a href="https://techtools365.com/" target="_blank" rel="noopener">TechTools365</a>. Calculations are for information only. Speak to a licensed adviser for personal advice.</p>
      <nav class="footer-links" aria-label="Footer">
        <a href="/about">About</a>
        <a href="/privacy">Privacy</a>
        <a href="https://tooljury.techtools365.com/" target="_blank" rel="noopener">ToolJury</a>
        <a href="https://wanderwise.techtools365.com/" target="_blank" rel="noopener">WanderWise</a>
      </nav>
    </div>
  </footer>

  {anyAdSlotConfigured && (
    <script is:inline>
      (function () {
        var ads = document.querySelectorAll('ins.adsbygoogle');
        for (var i = 0; i < ads.length; i++) {
          try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {}
        }
      })();
    </script>
  )}
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
