  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: 'Driving a Mortgaged Car from the UAE to Oman? You Need a Bank NOC',
    description: 'Bank-financed cars require a formal No Objection Certificate at every UAE-Oman land border. The paperwork can take up to two weeks.',
    datePublished: publishedDate,
    dateModified: publishedDate,
    author: { '@type': 'Person', name: 'Durga Prasad' },
    publisher: {
      '@type': 'Organization',
      name: 'WanderWise',
      logo: { '@type': 'ImageObject', url: 'https://wanderwise.techtools365.com/favicon.svg' },
    },
