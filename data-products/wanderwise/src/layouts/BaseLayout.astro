---
import AdScripts from '../components/AdScripts.astro';
import FamilyBar from '../components/FamilyBar.astro';
import FamilyFooter from '../components/FamilyFooter.astro';
import { ADSENSE_CLIENT, AD_SLOTS, isAdSlotConfigured } from '../lib/ads';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  keywords?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  canonicalUrl,
  ogImage,
  keywords,
  jsonLd,
  ogType = 'website',
} = Astro.props;

const siteUrl = 'https://wanderwise.techtools365.com';
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
const og = ogImage || `${siteUrl}/og-default.png`;
const currentPath = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#15161E" />

  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="author" content="TechTools365" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow" />
  <meta name="google-adsense-account" content="ca-pub-9446467058878539" />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title="WanderWise Travel Radar" href="/travel-radar/rss.xml" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="WanderWise — TechTools365" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:locale:alternate" content="en_IN" />
  <meta property="og:locale:alternate" content="en_AE" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={og} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://pagead2.googlesyndication.com" />
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300..700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/brand.css" />

  <AdScripts />

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <slot name="head" />
</head>
<body>
  <FamilyBar />
  <nav class="top" aria-label="WanderWise sections">
    <a href="/" class={currentPath === '/' ? 'is-active' : ''}>Visa Checker</a>
    <a href="/travel-radar/" class={currentPath.startsWith('/travel-radar') ? 'is-active' : ''}>Travel Radar</a>
    <a href="/about/" class={currentPath.startsWith('/about') ? 'is-active' : ''}>About</a>
  </nav>

  <main class="main">
    <slot />
    {isAdSlotConfigured(AD_SLOTS.inline) && (
      <aside class="ad-inline" aria-label="Advertisement">
        <ins class="adsbygoogle" style="display:block" data-ad-client={ADSENSE_CLIENT} data-ad-slot={AD_SLOTS.inline} data-ad-format="auto" data-full-width-responsive="true"></ins>
      </aside>
    )}
  </main>

  <FamilyFooter />

  <script is:inline>
    (function () {
      var ads = document.querySelectorAll('ins.adsbygoogle');
      for (var i = 0; i < ads.length; i++) {
        try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {}
      }
    })();
  </script>
</body>
</html>
<style is:global>
  @import '../styles/global.css';
</style>
