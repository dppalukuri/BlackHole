---
/** The TechTools365 footer on every page. The markup lives in shared/brand. */
import fs from 'node:fs';
import path from 'node:path';

const read = (file: string) => fs.readFileSync(path.resolve('..', 'shared', 'brand', file), 'utf-8');
const links = `<nav aria-label="WanderWise">
      <h2>WanderWise</h2>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/methodology/">Methodology</a></li>
        <li><a href="/privacy/">Privacy</a></li>
      </ul>
    </nav>`;
const html = read('family-footer.html')
  .replace('<!--BRAND-->', read('brand-mark.html').trim().replace(/GRADID/g, 'foot'))
  .replace('<!--SITE_LINKS-->', links)
  .replace('<!--SITE_FINE-->', 'Visa requirements can change without notice. Always check with the relevant embassy or consulate before booking travel.');
---

<Fragment set:html={html} />
