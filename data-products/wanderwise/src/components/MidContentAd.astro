---
/**
 * Inline responsive ad slot, for between content sections on long pages. Renders
 * nothing until a real slot ID is set in lib/ads.ts.
 */
import { ADSENSE_CLIENT, AD_SLOTS, isAdSlotConfigured } from '../lib/ads';

interface Props {
  slotId?: string;
}
const { slotId = AD_SLOTS.midContent } = Astro.props;
---
{isAdSlotConfigured(slotId) && (
  <aside class="mid-ad" aria-label="Advertisement">
    <ins class="adsbygoogle"
         style="display:block"
         data-ad-client={ADSENSE_CLIENT}
         data-ad-slot={slotId}
         data-ad-format="fluid"
         data-ad-layout="in-article"
         data-full-width-responsive="true"></ins>
  </aside>
)}

<style>
  .mid-ad { margin: 2rem 0; min-height: 120px; }
  .mid-ad ins.adsbygoogle { display: block; min-height: 100px; }
</style>
