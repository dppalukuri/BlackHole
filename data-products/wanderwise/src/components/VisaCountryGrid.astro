---
/**
 * A list of destination countries with their visa status.
 * Used on passport-specific and residence-permit-specific pages.
 *
 * Pass `kind` when every entry belongs to one status (a section headed "Visa-free", say):
 * rows then show only what differs from the heading. Without it, each row names its status.
 */
import { statusLabel, type VisaStatus } from '../lib/visa-data';

interface Entry {
  country: string;
  status: VisaStatus;
  days?: number | string;
  note?: string;
  source?: string;
  /** true when the entry is backed by a verified gov-sourced record. */
  verified?: boolean;
}

interface Props {
  entries: Entry[];
  title?: string;
  emptyLabel?: string;
  kind?: 'vf' | 'voa' | 'ev' | 'vr';
}

const { entries, title, emptyLabel = 'No entries in this category.', kind } = Astro.props;

function aside(e: Entry): string {
  const base = typeof e.status === 'number' ? 'vf' : e.status;
  const days = e.days ?? (typeof e.status === 'number' ? e.status : undefined);
  const stay = days ? `${days} days` : '';
  if (kind && base === kind) return stay;
  const label = base === 'vf' ? 'Visa-free' : statusLabel(base);
  return stay ? `${label} · ${stay}` : label;
}
---
{title && <h3 class="vcg-title">{title}</h3>}
{entries.length === 0 ? (
  <p class="vcg-empty">{emptyLabel}</p>
) : (
  <ul class="vcg-list">
    {entries.map((e) => (
      <li class="vcg-row">
        <div class="vcg-head">
          <span class="vcg-country">
            {e.country}
            {e.verified && (
              <span class="vcg-verified" title="Verified against an official government source" aria-label="verified">
                <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="currentColor" /><path d="M4.6 8.3l2.2 2.2 4.6-4.8" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            )}
          </span>
          {aside(e) && <span class="vcg-aside">{aside(e)}</span>}
        </div>
        {(e.note || e.source) && (
          <p class:list={['vcg-note', !e.note && 'only-source']}>
            {e.note}
            {e.source && (
              <a class="vcg-source" href={e.source} target="_blank" rel="noopener">Official source ↗</a>
            )}
          </p>
        )}
      </li>
    ))}
  </ul>
)}

<style>
  .vcg-title { font-size: 1.1rem; font-weight: 500; margin: 1.25rem 0 .6rem; }
  .vcg-empty { color: var(--muted); font-size: .92rem; }
  .vcg-list {
    list-style: none; padding: 0; margin: .9rem 0 1.75rem;
    columns: 3 300px; column-gap: 40px;
  }
  .vcg-row { break-inside: avoid; padding: 10px 0 11px; border-top: 1px solid var(--border); }
  .vcg-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .vcg-country { font-weight: 500; color: var(--text); display: inline-flex; align-items: center; gap: 6px; }
  .vcg-verified { display: inline-flex; color: var(--verified, #1E9E62); }
  .vcg-aside { font-size: .88rem; color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .vcg-note { font-size: .86rem; color: var(--muted); line-height: 1.45; margin: 3px 0 0; max-width: none !important; }
  .vcg-source { margin-left: 6px; white-space: nowrap; }
  .only-source .vcg-source { margin-left: 0; }
</style>
